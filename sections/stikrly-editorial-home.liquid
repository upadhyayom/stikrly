      #shopify-section-{{ section.id }} .stik-home__signage-grid,
      #shopify-section-{{ section.id }} .stik-home__community-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .stik-home__announcement-inner,
      #shopify-section-{{ section.id }} .stik-home__header-inner {
