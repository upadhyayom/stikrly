                {% endfor %}
              {% else %}
                {% for index in (1..3) %}
                  <div class="stik-home__bundle-frame"><div class="stik-home__placeholder"></div></div>
                {% endfor %}
              {% endif %}
            </div>
            <div class="stik-home__bundle-meta">
              <div>
                <span class="stik-home__bundle-save">{{ section.settings.bundle_right_save_label }}</span>
              </div>
              <h3 class="stik-home__bundle-title">{{ section.settings.bundle_right_title }}</h3>
              <div class="stik-home__bundle-price-line">
                <span class="stik-home__bundle-price">{{ section.settings.bundle_right_price }}</span>
                <span class="stik-home__bundle-compare">{{ section.settings.bundle_right_compare_price }}</span>
              </div>
              <span class="stik-home__bundle-button">Add bundle to cart</span>
              <p class="stik-home__bundle-note">{{ section.settings.bundle_right_note }}</p>
            </div>
          </a>
        </div>

        <div class="stik-home__bundle-builder">
          <h3>Create your own bundle</h3>
          <p>Mix and match any 3+ posters and get 15% off automatically at checkout</p>
          <a class="stik-home__text-button" href="{{ bundles_link }}">Start building</a>
        </div>
      </div>
    </div>
  </section>

  <section class="stik-home__section">
    <div class="stik-home__container">
      <div class="stik-home__section-head">
        <div>
          <h2 class="stik-home__section-title stik-home__signage-title">INDUSTRIAL SAFETY SIGNAGE</h2>
        </div>
        <a class="stik-home__section-link" href="{{ signage_collection.url | default: collection_link }}">View all</a>
      </div>

      <div class="stik-home__signage-grid">
        {% if signage_collection != blank and signage_collection.products_count > 0 %}
          {% for product in signage_collection.products limit: 4 %}
            <a class="stik-home__signage-card" href="{{ product.url }}">
              <div class="stik-home__product-media">
                {% if product.featured_media != blank %}
                  {{
                    product.featured_media.preview_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 540, 720, 900',
                      sizes: '(min-width: 900px) 23vw, 100vw'
                  }}
                {% else %}
                  <div class="stik-home__placeholder"></div>
                {% endif %}
              </div>
              <h3>{{ product.title }}</h3>
              <p>{{ product.price | money }}</p>
            </a>
          {% endfor %}
        {% else %}
          {% for index in (1..4) %}
            <div class="stik-home__signage-card">
              <div class="stik-home__product-media"><div class="stik-home__placeholder"></div></div>
              <h3>Industrial Sign {{ index }}</h3>
              <p>$19.99</p>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </section>

  <section class="stik-home__section stik-home__community">
    <div class="stik-home__container">
      <span class="stik-home__community-tag">#STIKRLY</span>
      <div class="stik-home__statement">
        <h2 class="stik-home__statement-title">STYLED BY <span>OUR COMMUNITY</span></h2>
        <p>Real homes, real style. See how our customers are making their spaces unique.</p>
      </div>

      <div class="stik-home__community-grid">
        <div class="stik-home__community-tile">
          {% if community_image_1 != blank %}
            {{ community_image_1 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 360, 540, 720, 900', sizes: '(min-width: 900px) 23vw, 100vw' }}
          {% else %}
            <div class="stik-home__placeholder"></div>
          {% endif %}
        </div>
        <div class="stik-home__community-tile">
          {% if community_image_2 != blank %}
            {{ community_image_2 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 360, 540, 720, 900', sizes: '(min-width: 900px) 23vw, 100vw' }}
          {% else %}
            <div class="stik-home__placeholder"></div>
          {% endif %}
        </div>
        <div class="stik-home__community-tile">
          {% if community_image_3 != blank %}
            {{ community_image_3 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 360, 540, 720, 900', sizes: '(min-width: 900px) 23vw, 100vw' }}
          {% else %}
            <div class="stik-home__placeholder"></div>
          {% endif %}
        </div>
        <div class="stik-home__community-tile">
          {% if community_image_4 != blank %}
            {{ community_image_4 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 360, 540, 720, 900', sizes: '(min-width: 900px) 23vw, 100vw' }}
          {% else %}
            <div class="stik-home__placeholder"></div>
          {% endif %}
        </div>
      </div>

      <p>Share your Stikrly style and get featured</p>
      <div style="margin-top: 18px;">
        <a class="stik-home__community-button" href="https://instagram.com" target="_blank" rel="noopener noreferrer">Follow @Stikrly</a>
      </div>
    </div>
  </section>

  <section class="stik-home__section">
    <div class="stik-home__container">
      <div class="stik-home__statement">
        <h2 class="stik-home__statement-title">THE STIKRLY <span>PROMISE</span></h2>
        <p>We're committed to delivering an exceptional experience from click to wall</p>
      </div>

      <div class="stik-home__promise-grid">
        <article class="stik-home__promise-card">
          <span class="stik-home__promise-icon"><svg viewBox="0 0 20 20" fill="none">{% render 'icon', icon: 'ruler' %}</svg></span>
          <div>
            <h3>Premium Quality Guarantee</h3>
            <p>Museum-grade paper with archival inks. If you're not satisfied, we'll make it right.</p>
          </div>
        </article>
        <article class="stik-home__promise-card">
          <span class="stik-home__promise-icon"><svg viewBox="0 0 20 20" fill="none">{% render 'icon', icon: 'truck' %}</svg></span>
          <div>
            <h3>Fast & Free Shipping</h3>
            <p>Free shipping on orders over $50. Express shipping available. Track your order every step.</p>
          </div>
        </article>
        <article class="stik-home__promise-card">
          <span class="stik-home__promise-icon"><svg viewBox="0 0 20 20" fill="none">{% render 'icon', icon: 'return' %}</svg></span>
          <div>
            <h3>30-Day Free Returns</h3>
            <p>Not in love with it? Return it within 30 days for a full refund, no questions asked.</p>
          </div>
        </article>
        <article class="stik-home__promise-card">
          <span class="stik-home__promise-icon"><svg viewBox="0 0 20 20" fill="none">{% render 'icon', icon: 'lock' %}</svg></span>
          <div>
            <h3>Secure Checkout</h3>
            <p>256-bit SSL encryption. We accept all major credit cards, PayPal, and Apple Pay.</p>
          </div>
        </article>
        <article class="stik-home__promise-card">
          <span class="stik-home__promise-icon"><svg viewBox="0 0 20 20" fill="none">{% render 'icon', icon: 'box' %}</svg></span>
          <div>
            <h3>Premium Packaging</h3>
            <p>Each print arrives in protective packaging designed to ensure perfect condition.</p>
          </div>
        </article>
        <article class="stik-home__promise-card">
          <span class="stik-home__promise-icon">{{ 'icon-info.svg' | inline_asset_content }}</span>
          <div>
            <h3>Lifetime Support</h3>
            <p>Our customer service team is here to help you, today and always.</p>
          </div>
        </article>
      </div>

      <div class="stik-home__care">
        <div class="stik-home__care-media">
          {% if care_image != blank %}
            {{
              care_image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '720, 960, 1200, 1600',
                sizes: '(min-width: 900px) 52vw, 100vw'
            }}
          {% else %}
            <div class="stik-home__placeholder"></div>
          {% endif %}
        </div>
        <div class="stik-home__care-content">
          <p class="stik-home__eyebrow">Premium Unboxing Experience</p>
          <h3>PACKAGED WITH CARE &amp; STYLE</h3>
          <p>
            Every poster arrives in our signature packaging - protective, sustainable, and designed to impress. We use rigid mailers and acid-free tissue paper to ensure your prints arrive in perfect condition.
          </p>
          <ul class="stik-home__care-list">
            <li>Rigid protective mailers prevent bending</li>
            <li>Acid-free tissue paper protection</li>
            <li>100% recyclable materials</li>
            <li>Branded unboxing experience</li>
          </ul>
        </div>
      </div>

      <div class="stik-home__payments">
        <strong>Secure Payment Methods</strong>
        <div class="stik-home__payments-list">
          <span>Visa</span>
          <span>Mastercard</span>
          <span>Amex</span>
          <span>PayPal</span>
          <span>Apple Pay</span>
          <span>Google Pay</span>
        </div>
      </div>
    </div>
  </section>

  <footer class="stik-home__footer">
    <div class="stik-home__container">
      <div class="stik-home__footer-head">
        <h3>JOIN THE <span>MOVEMENT</span></h3>
        <p>Get exclusive access to new drops, special offers, and design inspiration.</p>

        {% form 'customer', class: 'stik-home__newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            value="{% if customer %}{{ customer.email }}{% endif %}"
            placeholder="Enter your email"
            autocorrect="off"
            autocapitalize="off"
          >
          <button type="submit">Subscribe</button>
          {% if form.posted_successfully? %}
            <div class="stik-home__newsletter-status">Thanks for subscribing.</div>
          {% endif %}
          {% if form.errors %}
            <div class="stik-home__newsletter-status">{{ form.errors | default_errors }}</div>
          {% endif %}
        {% endform %}
      </div>

      <div class="stik-home__footer-body">
        <div class="stik-home__footer-brand">
          <strong>STICKRLY</strong>
          <p>Bold designs for bold spaces. Make your walls speak.</p>
          <div class="stik-home__social">
            <a href="https://instagram.com" aria-label="Instagram" target="_blank" rel="noopener noreferrer">◌</a>
            <a href="https://twitter.com" aria-label="Twitter" target="_blank" rel="noopener noreferrer">𝕏</a>
            <a href="https://facebook.com" aria-label="Facebook" target="_blank" rel="noopener noreferrer">f</a>
            <a href="mailto:hello@example.com" aria-label="Email">✉</a>
          </div>
        </div>

        <div>
          <h4>Shop</h4>
          <ul class="stik-home__footer-links">
            <li><a href="{{ posters_link }}">All Posters</a></li>
            <li><a href="{{ frames_link }}">Frames</a></li>
            <li><a href="{{ bundles_link }}">Bundles</a></li>
            <li><a href="{{ collection_link }}">New Arrivals</a></li>
            <li><a href="{{ collection_link }}">Best Sellers</a></li>
          </ul>
        </div>

        <div>
          <h4>Support</h4>
          <ul class="stik-home__footer-links">
            <li><a href="/pages/contact">Contact Us</a></li>
            <li><a href="/pages/shipping-policy">Shipping Info</a></li>
            <li><a href="/pages/refund-policy">Returns</a></li>
            <li><a href="/pages/faq">FAQ</a></li>
            <li><a href="/pages/size-guide">Size Guide</a></li>
          </ul>
        </div>

        <div>
          <h4>Company</h4>
          <ul class="stik-home__footer-links">
            <li><a href="{{ about_link }}">About Us</a></li>
            <li><a href="/pages/our-story">Our Story</a></li>
            <li><a href="/pages/sustainability">Sustainability</a></li>
            <li><a href="/pages/press">Press</a></li>
            <li><a href="/pages/careers">Careers</a></li>
          </ul>
        </div>
      </div>

      <div class="stik-home__footer-bottom">
        <span>© 2026 Stickrly. All rights reserved.</span>
        <div class="stik-home__footer-legal">
          <a href="/policies/privacy-policy">Privacy Policy</a>
          <a href="/policies/terms-of-service">Terms of Service</a>
          <a href="/policies/shipping-policy">Cookies</a>
        </div>
      </div>
    </div>
  </footer>
</section>

