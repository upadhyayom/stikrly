{% liquid
  assign catalog_collection = section.settings.best_sellers_collection
  if catalog_collection == blank
    assign catalog_collection = collections['all']
  endif

  assign manifesto_collection = section.settings.manifesto_collection
  if manifesto_collection == blank
    assign manifesto_collection = catalog_collection
  endif

  assign signage_collection = section.settings.signage_collection
  if signage_collection == blank
    assign signage_collection = catalog_collection
  endif

  assign hero_image = section.settings.hero_image
  if hero_image == blank and catalog_collection != blank and catalog_collection.products_count > 0
    assign hero_image = catalog_collection.products.first.featured_media.preview_image
  endif

  assign care_image = section.settings.care_image
  if care_image == blank
    assign care_image = hero_image
  endif

  assign category_one_collection = section.settings.category_1_collection
  assign category_two_collection = section.settings.category_2_collection
  assign category_three_collection = section.settings.category_3_collection
  assign category_four_collection = section.settings.category_4_collection

  assign category_one_image = category_one_collection.featured_image
  if category_one_image == blank and category_one_collection != blank and category_one_collection.products_count > 0
    assign category_one_image = category_one_collection.products.first.featured_media.preview_image
  endif
  if category_one_image == blank and catalog_collection != blank and catalog_collection.products_count > 0
    assign category_one_image = catalog_collection.products[0].featured_media.preview_image
  endif

  assign category_two_image = category_two_collection.featured_image
  if category_two_image == blank and category_two_collection != blank and category_two_collection.products_count > 0
    assign category_two_image = category_two_collection.products.first.featured_media.preview_image
  endif
  if category_two_image == blank and catalog_collection != blank and catalog_collection.products_count > 1
    assign category_two_image = catalog_collection.products[1].featured_media.preview_image
  endif

  assign category_three_image = category_three_collection.featured_image
  if category_three_image == blank and category_three_collection != blank and category_three_collection.products_count > 0
    assign category_three_image = category_three_collection.products.first.featured_media.preview_image
  endif
  if category_three_image == blank and catalog_collection != blank and catalog_collection.products_count > 2
    assign category_three_image = catalog_collection.products[2].featured_media.preview_image
  endif

  assign category_four_image = category_four_collection.featured_image
  if category_four_image == blank and category_four_collection != blank and category_four_collection.products_count > 0
    assign category_four_image = category_four_collection.products.first.featured_media.preview_image
  endif
  if category_four_image == blank and catalog_collection != blank and catalog_collection.products_count > 3
    assign category_four_image = catalog_collection.products[3].featured_media.preview_image
  endif

  assign bundle_left_collection = section.settings.bundle_left_collection
  if bundle_left_collection == blank
    assign bundle_left_collection = catalog_collection
  endif

  assign bundle_right_collection = section.settings.bundle_right_collection
  if bundle_right_collection == blank
    assign bundle_right_collection = manifesto_collection
  endif

  assign community_image_1 = section.settings.community_image_1
  assign community_image_2 = section.settings.community_image_2
  assign community_image_3 = section.settings.community_image_3
  assign community_image_4 = section.settings.community_image_4

  if community_image_1 == blank
    assign community_image_1 = hero_image
  endif
  if community_image_2 == blank and catalog_collection != blank and catalog_collection.products_count > 1
    assign community_image_2 = catalog_collection.products[1].featured_media.preview_image
  endif
  if community_image_3 == blank and catalog_collection != blank and catalog_collection.products_count > 2
    assign community_image_3 = catalog_collection.products[2].featured_media.preview_image
  endif
  if community_image_4 == blank and catalog_collection != blank and catalog_collection.products_count > 3
    assign community_image_4 = catalog_collection.products[3].featured_media.preview_image
  endif

  assign collection_link = catalog_collection.url | default: routes.all_products_collection_url
  assign bundles_link = bundle_left_collection.url | default: collection_link
  assign posters_link = category_one_collection.url | default: collection_link
  assign frames_link = category_two_collection.url | default: collection_link
  assign cozy_cards_link = category_three_collection.url | default: collection_link
  assign calendars_link = category_four_collection.url | default: collection_link
  assign about_link = section.settings.about_link | default: routes.root_url
%}

<section class="stik-home">
  <style>
    body:has(#shopify-section-{{ section.id }} .stik-home) {
      --header-group-height: 0px;
      background: #ffffff;
    }

    body:has(#shopify-section-{{ section.id }} .stik-home) #header-group,
    body:has(#shopify-section-{{ section.id }} .stik-home) > footer {
      display: none;
    }

    #shopify-section-{{ section.id }} .stik-home {
      --stik-black: #050505;
      --stik-ink: #111111;
      --stik-accent: #ef3d2f;
      --stik-muted: #757575;
      --stik-line: #e8e8e8;
      --stik-soft: #f7f7f7;
      --stik-shell: min(1456px, calc(100% - 48px));
      color: var(--stik-ink);
      background: #ffffff;
      font-family: var(--font-body--family);
    }

    #shopify-section-{{ section.id }} .stik-home__container {
      width: var(--stik-shell);
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .stik-home__announcement {
      background: var(--stik-black);
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    #shopify-section-{{ section.id }} .stik-home__announcement-inner {
      width: var(--stik-shell);
      min-height: 32px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      position: relative;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .stik-home__announcement-dismiss {
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      color: rgba(255, 255, 255, 0.8);
      border: 0;
      font-size: 0.9rem;
      cursor: default;
    }

    #shopify-section-{{ section.id }} .stik-home__header {
      border-bottom: 1px solid var(--stik-line);
      background: #ffffff;
    }

    #shopify-section-{{ section.id }} .stik-home__header-inner {
      width: var(--stik-shell);
      margin: 0 auto;
      min-height: 70px;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .stik-home__logo {
      display: inline-flex;
      align-items: center;
      font-family: var(--font-heading--family);
      font-size: clamp(1.8rem, 2.4vw, 2.55rem);
      font-weight: 900;
      letter-spacing: -0.06em;
      line-height: 1;
      text-decoration: none;
      color: #ffce3d;
      text-shadow: -2px -2px 0 #00b9c5, 2px 2px 0 #ef3d2f;
      -webkit-text-stroke: 1.4px #111111;
    }

    #shopify-section-{{ section.id }} .stik-home__nav {
      display: flex;
      justify-content: center;
      gap: 34px;
    }

    #shopify-section-{{ section.id }} .stik-home__nav a,
    #shopify-section-{{ section.id }} .stik-home__utility-link,
    #shopify-section-{{ section.id }} .stik-home__section-link,
    #shopify-section-{{ section.id }} .stik-home__category-card,
    #shopify-section-{{ section.id }} .stik-home__button,
    #shopify-section-{{ section.id }} .stik-home__text-button,
    #shopify-section-{{ section.id }} .stik-home__product-card,
    #shopify-section-{{ section.id }} .stik-home__community-button,
    #shopify-section-{{ section.id }} .stik-home__bundle-card,
    #shopify-section-{{ section.id }} .stik-home__social a,
    #shopify-section-{{ section.id }} .stik-home__footer-links a {
      text-decoration: none;
      color: inherit;
    }

    #shopify-section-{{ section.id }} .stik-home__nav a {
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .stik-home__nav a:hover,
    #shopify-section-{{ section.id }} .stik-home__section-link:hover,
    #shopify-section-{{ section.id }} .stik-home__text-button:hover,
    #shopify-section-{{ section.id }} .stik-home__utility-link:hover,
    #shopify-section-{{ section.id }} .stik-home__footer-links a:hover {
      color: var(--stik-accent);
    }

    #shopify-section-{{ section.id }} .stik-home__header-tools {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    #shopify-section-{{ section.id }} .stik-home__utility-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      color: var(--stik-ink);
    }

    #shopify-section-{{ section.id }} .stik-home__utility-link svg {
      width: 18px;
      height: 18px;
      display: block;
    }

    #shopify-section-{{ section.id }} .stik-home__cart-count {
      position: absolute;
      top: -7px;
      right: -7px;
      width: 16px;
      height: 16px;
      border-radius: 999px;
      background: var(--stik-accent);
      color: #ffffff;
      font-size: 0.62rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .stik-home__hero {
      padding: 36px 0 28px;
      display: grid;
      grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
      gap: 34px;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .stik-home__hero-copy {
      padding: 28px 0;
      display: grid;
      gap: 28px;
    }

    #shopify-section-{{ section.id }} .stik-home__rating {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.88rem;
      color: var(--stik-muted);
    }

    #shopify-section-{{ section.id }} .stik-home__stars {
      color: var(--stik-accent);
      font-size: 0.96rem;
      letter-spacing: 0.08em;
    }

    #shopify-section-{{ section.id }} .stik-home__hero-title {
      margin: 0;
      font-family: var(--font-heading--family);
      font-size: clamp(4rem, 8vw, 6.1rem);
      font-weight: 900;
      line-height: 0.86;
      letter-spacing: -0.09em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .stik-home__hero-title span {
      color: var(--stik-accent);
    }

    #shopify-section-{{ section.id }} .stik-home__hero-body {
      max-width: 28rem;
      margin: 0;
      color: var(--stik-muted);
      font-size: 1rem;
      line-height: 1.8;
    }

    #shopify-section-{{ section.id }} .stik-home__micro-list {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .stik-home__micro-list span {
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    #shopify-section-{{ section.id }} .stik-home__micro-list span::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: var(--stik-ink);
      display: inline-block;
    }

    #shopify-section-{{ section.id }} .stik-home__hero-actions,
    #shopify-section-{{ section.id }} .stik-home__manifesto-actions,
    #shopify-section-{{ section.id }} .stik-home__bundle-builder {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .stik-home__button,
    #shopify-section-{{ section.id }} .stik-home__text-button,
    #shopify-section-{{ section.id }} .stik-home__community-button {
      min-height: 46px;
      padding: 0 22px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--stik-ink);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: transform 0.16s ease, background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease;
    }

    #shopify-section-{{ section.id }} .stik-home__button {
      background: var(--stik-ink);
      color: #ffffff;
    }

    #shopify-section-{{ section.id }} .stik-home__text-button,
    #shopify-section-{{ section.id }} .stik-home__community-button {
      background: #ffffff;
      color: var(--stik-ink);
    }

    #shopify-section-{{ section.id }} .stik-home__button:hover,
    #shopify-section-{{ section.id }} .stik-home__text-button:hover,
    #shopify-section-{{ section.id }} .stik-home__community-button:hover {
      transform: translateY(-1px);
      border-color: var(--stik-accent);
      color: #ffffff;
      background: var(--stik-accent);
    }

    #shopify-section-{{ section.id }} .stik-home__hero-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      padding-top: 8px;
    }

    #shopify-section-{{ section.id }} .stik-home__hero-stat strong {
      display: block;
      margin-bottom: 2px;
      font-family: var(--font-heading--family);
      font-size: clamp(1.8rem, 2vw, 2.45rem);
      font-weight: 900;
      letter-spacing: -0.05em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .stik-home__hero-stat span {
      display: block;
      color: var(--stik-muted);
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .stik-home__hero-media {
      position: relative;
      min-height: 690px;
      border-radius: 10px;
      overflow: hidden;
      background: linear-gradient(145deg, #eae3d8 0%, #d0c3b2 100%);
    }

    #shopify-section-{{ section.id }} .stik-home__hero-media img,
    #shopify-section-{{ section.id }} .stik-home__category-media img,
    #shopify-section-{{ section.id }} .stik-home__product-media img,
    #shopify-section-{{ section.id }} .stik-home__manifesto-media img,
    #shopify-section-{{ section.id }} .stik-home__bundle-frame img,
    #shopify-section-{{ section.id }} .stik-home__community-tile img,
    #shopify-section-{{ section.id }} .stik-home__care-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #shopify-section-{{ section.id }} .stik-home__placeholder {
      width: 100%;
      height: 100%;
      min-height: inherit;
      background:
        radial-gradient(circle at top left, rgba(239, 61, 47, 0.22), transparent 30%),
        linear-gradient(145deg, #ece4d9 0%, #d5c8b7 100%);
    }

    #shopify-section-{{ section.id }} .stik-home__trusted-badge,
    #shopify-section-{{ section.id }} .stik-home__sale-badge {
      position: absolute;
      z-index: 2;
      display: inline-flex;
      flex-direction: column;
      gap: 3px;
      padding: 12px 14px;
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .stik-home__trusted-badge {
      top: 22px;
      right: 22px;
      background: #ffffff;
      color: var(--stik-ink);
      box-shadow: 0 12px 28px rgba(17, 17, 17, 0.09);
    }

    #shopify-section-{{ section.id }} .stik-home__trusted-badge strong {
      font-family: var(--font-heading--family);
      font-size: 1.45rem;
      letter-spacing: -0.04em;
    }

    #shopify-section-{{ section.id }} .stik-home__sale-badge {
      left: 22px;
      bottom: 20px;
      background: var(--stik-accent);
      color: #ffffff;
      transform: rotate(-6deg);
    }

    #shopify-section-{{ section.id }} .stik-home__feature-strip {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      border-top: 1px solid var(--stik-line);
      border-bottom: 1px solid var(--stik-line);
    }

    #shopify-section-{{ section.id }} .stik-home__feature-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 18px 16px;
      border-right: 1px solid var(--stik-line);
    }

    #shopify-section-{{ section.id }} .stik-home__feature-item:last-child {
      border-right: 0;
    }

    #shopify-section-{{ section.id }} .stik-home__icon-badge,
    #shopify-section-{{ section.id }} .stik-home__promise-icon {
      width: 34px;
      height: 34px;
      border-radius: 999px;
      background: var(--stik-black);
      color: #ffffff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
    }

    #shopify-section-{{ section.id }} .stik-home__icon-badge svg,
    #shopify-section-{{ section.id }} .stik-home__promise-icon svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
    }

    #shopify-section-{{ section.id }} .stik-home__feature-text strong {
      display: block;
      margin-bottom: 3px;
      font-size: 0.84rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .stik-home__feature-text span {
      display: block;
      color: var(--stik-muted);
      font-size: 0.78rem;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .stik-home__section {
      padding: 72px 0;
    }

    #shopify-section-{{ section.id }} .stik-home__section--soft {
      background: var(--stik-soft);
    }

    #shopify-section-{{ section.id }} .stik-home__section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
    }

    #shopify-section-{{ section.id }} .stik-home__section-title,
    #shopify-section-{{ section.id }} .stik-home__statement-title {
      margin: 0;
      font-family: var(--font-heading--family);
      font-weight: 900;
      line-height: 0.92;
      letter-spacing: -0.07em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .stik-home__section-title {
      font-size: clamp(2.3rem, 4vw, 3.8rem);
      max-width: 8ch;
    }

    #shopify-section-{{ section.id }} .stik-home__section-copy {
      margin: 0;
      color: var(--stik-muted);
      font-size: 0.98rem;
      line-height: 1.7;
    }

    #shopify-section-{{ section.id }} .stik-home__section-link {
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--stik-muted);
    }

    #shopify-section-{{ section.id }} .stik-home__category-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .stik-home__category-card {
      position: relative;
      min-height: 310px;
      overflow: hidden;
      border-radius: 8px;
      background: #d9d9d9;
    }

    #shopify-section-{{ section.id }} .stik-home__category-media {
      height: 100%;
      min-height: 310px;
    }

    #shopify-section-{{ section.id }} .stik-home__category-overlay {
      position: absolute;
      inset: auto 0 0 0;
      padding: 18px 18px 20px;
      color: #ffffff;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 0%, rgba(0, 0, 0, 0.72) 100%);
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .stik-home__category-overlay strong {
      display: block;
      margin-bottom: 4px;
      font-size: 0.98rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .stik-home__category-overlay span {
      display: block;
      color: rgba(255, 255, 255, 0.75);
      font-size: 0.74rem;
    }

    #shopify-section-{{ section.id }} .stik-home__category-arrow {
      width: 30px;
      height: 30px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.18);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
    }

    #shopify-section-{{ section.id }} .stik-home__category-arrow svg {
      width: 14px;
      height: 14px;
    }

    #shopify-section-{{ section.id }} .stik-home__product-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }

    #shopify-section-{{ section.id }} .stik-home__product-card {
      display: grid;
      gap: 14px;
    }

    #shopify-section-{{ section.id }} .stik-home__product-media,
    #shopify-section-{{ section.id }} .stik-home__manifesto-media {
      position: relative;
      border-radius: 8px;
      overflow: hidden;
      background: linear-gradient(145deg, #ece4d9 0%, #d5c8b7 100%);
    }

    #shopify-section-{{ section.id }} .stik-home__product-media {
      aspect-ratio: 0.84;
    }

    #shopify-section-{{ section.id }} .stik-home__manifesto-media {
      aspect-ratio: 0.86;
    }

    #shopify-section-{{ section.id }} .stik-home__product-badge,
    #shopify-section-{{ section.id }} .stik-home__bundle-save {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 24px;
      padding: 0 10px;
      background: var(--stik-accent);
      color: #ffffff;
      font-size: 0.64rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .stik-home__product-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 1;
    }

    #shopify-section-{{ section.id }} .stik-home__product-meta {
      display: grid;
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .stik-home__product-rating {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--stik-muted);
      font-size: 0.78rem;
    }

    #shopify-section-{{ section.id }} .stik-home__product-rating span:first-child {
      color: var(--stik-accent);
      font-size: 0.86rem;
    }

    #shopify-section-{{ section.id }} .stik-home__product-title {
      margin: 0;
      font-size: 1.14rem;
