<div class="stik-home__container">
  <section class="stik-home__feature-strip" aria-label="Store benefits">
    {% for index in (1..4) %}
      {% liquid
        assign icon_key = 'item_' | append: index | append: '_icon'
        assign title_key = 'item_' | append: index | append: '_title'
        assign text_key = 'item_' | append: index | append: '_text'
      %}
      <div class="stik-home__feature-item">
        <span class="stik-home__icon-badge">
          {% if section.settings[icon_key] == 'info' %}
            {{ 'icon-info.svg' | inline_asset_content }}
          {% else %}
            <svg viewBox="0 0 20 20" fill="none">{% render 'icon', icon: section.settings[icon_key] %}</svg>
          {% endif %}
        </span>
        <div class="stik-home__feature-text">
          <strong>{{ section.settings[title_key] }}</strong>
          <span>{{ section.settings[text_key] }}</span>
        </div>
      </div>
    {% endfor %}
  </section>
</div>

