<footer class="stik-home__footer">
  <div class="stik-home__container stik-home__footer-shell">
    <div class="stik-home__footer-head">
      <h3>
        {{ section.settings.heading_prefix }}
        <span>{{ section.settings.heading_accent }}</span>
      </h3>
      <p>{{ section.settings.copy }}</p>

      {% form 'customer', class: 'stik-home__newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          value="{% if customer %}{{ customer.email }}{% endif %}"
          placeholder="{{ section.settings.placeholder }}"
          autocorrect="off"
          autocapitalize="off"
        >
        <button type="submit">{{ section.settings.button_label }}</button>
        {% if form.posted_successfully? %}
          <div class="stik-home__newsletter-status">{{ section.settings.success_text }}</div>
        {% endif %}
        {% if form.errors %}
          <div class="stik-home__newsletter-status">{{ form.errors | default_errors }}</div>
        {% endif %}
      {% endform %}
    </div>

    <div class="stik-home__footer-body">
      <div class="stik-home__footer-brand">
        <strong>{{ section.settings.brand_title }}</strong>
        <p>{{ section.settings.brand_copy }}</p>
        <div class="stik-home__social">
          <a href="{{ section.settings.instagram_url | default: 'https://instagram.com' }}" aria-label="Instagram" target="_blank" rel="noopener noreferrer">◌</a>
          <a href="{{ section.settings.x_url | default: 'https://twitter.com' }}" aria-label="X" target="_blank" rel="noopener noreferrer">𝕏</a>
          <a href="{{ section.settings.facebook_url | default: 'https://facebook.com' }}" aria-label="Facebook" target="_blank" rel="noopener noreferrer">f</a>
          <a href="{{ section.settings.email_url | default: 'mailto:hello@example.com' }}" aria-label="Email">✉</a>
        </div>
      </div>

      <div>
        <h4>{{ section.settings.shop_heading }}</h4>
        <ul class="stik-home__footer-links">
          {% if section.settings.shop_menu != blank %}
            {% for link in section.settings.shop_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="{{ routes.all_products_collection_url }}">All Posters</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Frames</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Bundles</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">New Arrivals</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Best Sellers</a></li>
          {% endif %}
        </ul>
      </div>

      <div>
        <h4>{{ section.settings.support_heading }}</h4>
        <ul class="stik-home__footer-links">
          {% if section.settings.support_menu != blank %}
            {% for link in section.settings.support_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/pages/contact">Contact Us</a></li>
            <li><a href="/pages/shipping-policy">Shipping Info</a></li>
            <li><a href="/pages/refund-policy">Returns</a></li>
            <li><a href="/pages/faq">FAQ</a></li>
            <li><a href="/pages/size-guide">Size Guide</a></li>
          {% endif %}
        </ul>
      </div>

      <div>
        <h4>{{ section.settings.company_heading }}</h4>
        <ul class="stik-home__footer-links">
          {% if section.settings.company_menu != blank %}
            {% for link in section.settings.company_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="{{ routes.root_url }}">About Us</a></li>
            <li><a href="/pages/our-story">Our Story</a></li>
            <li><a href="/pages/sustainability">Sustainability</a></li>
            <li><a href="/pages/press">Press</a></li>
            <li><a href="/pages/careers">Careers</a></li>
          {% endif %}
        </ul>
      </div>
    </div>

    <div class="stik-home__footer-bottom">
      <span>{{ section.settings.bottom_copy }}</span>
      <div class="stik-home__footer-legal">
        <a href="{{ section.settings.legal_1_link | default: '/policies/privacy-policy' }}">{{ section.settings.legal_1_label }}</a>
        <a href="{{ section.settings.legal_2_link | default: '/policies/terms-of-service' }}">{{ section.settings.legal_2_label }}</a>
        <a href="{{ section.settings.legal_3_link | default: '/policies/shipping-policy' }}">{{ section.settings.legal_3_label }}</a>
      </div>
    </div>
  </div>
</footer>

