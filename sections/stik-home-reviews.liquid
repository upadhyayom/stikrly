<section class="stik-home__section stik-home__reviews">
  <div class="stik-home__container">
    <div class="stik-home__statement">
      <h2 class="stik-home__statement-title">
        {{ section.settings.heading_prefix }}
        <span>{{ section.settings.heading_accent }}</span>
      </h2>
      <p>{{ section.settings.copy }}</p>
    </div>

    <div class="stik-home__metrics">
      {% for index in (1..4) %}
        {% liquid
          assign value_key = 'metric_' | append: index | append: '_value'
          assign label_key = 'metric_' | append: index | append: '_label'
          assign accent_key = 'metric_' | append: index | append: '_accent'
        %}
        <div class="stik-home__metric">
          <strong{% if section.settings[accent_key] %} class="is-accent"{% endif %}>{{ section.settings[value_key] }}</strong>
          <span>{{ section.settings[label_key] }}</span>
        </div>
      {% endfor %}
    </div>

    <div class="stik-home__review-grid">
      {% for index in (1..3) %}
        {% liquid
          assign image_key = 'review_' | append: index | append: '_image'
          assign text_key = 'review_' | append: index | append: '_text'
          assign author_key = 'review_' | append: index | append: '_author'
          assign role_key = 'review_' | append: index | append: '_role'
        %}
        <article class="stik-home__review-card">
          <span class="stik-home__quote">”</span>
          <div class="stik-home__review-stars">★★★★★</div>
          <p>{{ section.settings[text_key] }}</p>
          <div class="stik-home__review-author">
            <div class="stik-home__review-avatar">
              {% if section.settings[image_key] != blank %}
                {{
                  section.settings[image_key]
                  | image_url: width: 120
                  | image_tag: loading: 'lazy', widths: '60, 120', sizes: '46px'
                }}
              {% else %}
                <div class="stik-home__placeholder"></div>
              {% endif %}
            </div>
            <div>
              <strong>{{ section.settings[author_key] }}</strong>
              <span>{{ section.settings[role_key] }}</span>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="stik-home__logo-strip">
      {% for index in (1..3) %}
        {% assign logo_key = 'logo_' | append: index %}
        <span>{{ section.settings[logo_key] }}</span>
      {% endfor %}
    </div>
  </div>
</section>

