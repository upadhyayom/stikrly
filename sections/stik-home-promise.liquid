<section class="stik-home__section">
  <div class="stik-home__container">
    <div class="stik-home__statement">
      <h2 class="stik-home__statement-title">
        {{ section.settings.heading_prefix }}
        <span>{{ section.settings.heading_accent }}</span>
      </h2>
      <p>{{ section.settings.copy }}</p>
    </div>

    <div class="stik-home__promise-grid">
      {% for index in (1..6) %}
        {% liquid
          assign icon_key = 'card_' | append: index | append: '_icon'
          assign title_key = 'card_' | append: index | append: '_title'
          assign text_key = 'card_' | append: index | append: '_text'
        %}
        <article class="stik-home__promise-card">
          <span class="stik-home__promise-icon">
            {% if section.settings[icon_key] == 'info' %}
              {{ 'icon-info.svg' | inline_asset_content }}
            {% else %}
              <svg viewBox="0 0 20 20" fill="none">{% render 'icon', icon: section.settings[icon_key] %}</svg>
            {% endif %}
          </span>
          <div>
            <h3>{{ section.settings[title_key] }}</h3>
            <p>{{ section.settings[text_key] }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

