    {
      "type": "text",
      "id": "right_button_label",
      "label": "Right button label",
      "default": "Add bundle to cart"
    },
    {
      "type": "text",
      "id": "right_note",
      "label": "Right note",
      "default": "Free shipping on all bundles"
    },
    {
      "type": "text",
      "id": "builder_heading",
      "label": "Builder heading",
      "default": "Create your own bundle"
    },
    {
      "type": "textarea",
      "id": "builder_copy",
      "label": "Builder copy",
      "default": "Mix and match any 3+ posters and get 15% off automatically at checkout"
