{% liquid
  assign left_collection = section.settings.left_collection
  assign right_collection = section.settings.right_collection
  assign left_link = section.settings.left_link | default: left_collection.url | default: routes.all_products_collection_url
  assign right_link = section.settings.right_link | default: right_collection.url | default: routes.all_products_collection_url
  assign builder_link = section.settings.builder_link | default: left_collection.url | default: routes.all_products_collection_url
%}

<section class="stik-home__section">
  <div class="stik-home__container">
    <div class="stik-home__bundles-shell">
      <div class="stik-home__section-head">
        <div>
          <h2 class="stik-home__section-title">{{ section.settings.heading }}</h2>
          <p class="stik-home__section-copy">{{ section.settings.copy }}</p>
        </div>
      </div>

      <div class="stik-home__bundle-grid">
        <a class="stik-home__bundle-card" href="{{ left_link }}">
          <div class="stik-home__bundle-frames">
            {% if left_collection != blank and left_collection.products_count > 0 %}
              {% for product in left_collection.products limit: 3 %}
                <div class="stik-home__bundle-frame">
                  {% if product.featured_media != blank %}
                    {{
                      product.featured_media.preview_image
                      | image_url: width: 700
                      | image_tag:
                        loading: 'lazy',
                        widths: '240, 360, 540, 700',
                        sizes: '(min-width: 900px) 14vw, 33vw'
                    }}
                  {% else %}
                    <div class="stik-home__placeholder"></div>
                  {% endif %}
                </div>
              {% endfor %}
            {% else %}
              {% for index in (1..3) %}
                <div class="stik-home__bundle-frame"><div class="stik-home__placeholder"></div></div>
              {% endfor %}
            {% endif %}
          </div>
          <div class="stik-home__bundle-meta">
            <div>
              <span class="stik-home__bundle-save">{{ section.settings.left_save_label }}</span>
            </div>
            <h3 class="stik-home__bundle-title">{{ section.settings.left_title }}</h3>
            <div class="stik-home__bundle-price-line">
              <span class="stik-home__bundle-price">{{ section.settings.left_price }}</span>
              <span class="stik-home__bundle-compare">{{ section.settings.left_compare_price }}</span>
            </div>
            <span class="stik-home__bundle-button">{{ section.settings.left_button_label }}</span>
            <p class="stik-home__bundle-note">{{ section.settings.left_note }}</p>
          </div>
        </a>

        <a class="stik-home__bundle-card" href="{{ right_link }}">
          <div class="stik-home__bundle-frames">
            {% if right_collection != blank and right_collection.products_count > 0 %}
              {% for product in right_collection.products limit: 3 %}
                <div class="stik-home__bundle-frame">
                  {% if product.featured_media != blank %}
                    {{
                      product.featured_media.preview_image
                      | image_url: width: 700
                      | image_tag:
                        loading: 'lazy',
                        widths: '240, 360, 540, 700',
                        sizes: '(min-width: 900px) 14vw, 33vw'
                    }}
                  {% else %}
                    <div class="stik-home__placeholder"></div>
                  {% endif %}
                </div>
              {% endfor %}
            {% else %}
              {% for index in (1..3) %}
                <div class="stik-home__bundle-frame"><div class="stik-home__placeholder"></div></div>
              {% endfor %}
            {% endif %}
          </div>
          <div class="stik-home__bundle-meta">
            <div>
              <span class="stik-home__bundle-save">{{ section.settings.right_save_label }}</span>
            </div>
            <h3 class="stik-home__bundle-title">{{ section.settings.right_title }}</h3>
            <div class="stik-home__bundle-price-line">
              <span class="stik-home__bundle-price">{{ section.settings.right_price }}</span>
              <span class="stik-home__bundle-compare">{{ section.settings.right_compare_price }}</span>
            </div>
            <span class="stik-home__bundle-button">{{ section.settings.right_button_label }}</span>
            <p class="stik-home__bundle-note">{{ section.settings.right_note }}</p>
          </div>
        </a>
      </div>

      <div class="stik-home__bundle-builder">
        <h3>{{ section.settings.builder_heading }}</h3>
        <p>{{ section.settings.builder_copy }}</p>
        <a class="stik-home__text-button" href="{{ builder_link }}">{{ section.settings.builder_button_label }}</a>
      </div>
    </div>
  </div>
</section>

