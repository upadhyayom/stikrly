    },
    {
      "type": "url",
      "id": "right_link",
      "label": "Right bundle link"
    },
    {
      "type": "text",
      "id": "right_save_label",
      "label": "Right save label",
      "default": "Save $20 4 Posters"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Right title",
      "default": "Bold Statement Set"
    },
    {
      "type": "text",
      "id": "right_price",
